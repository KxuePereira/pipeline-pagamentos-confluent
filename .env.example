# =====================================================================
# Copie para .env e preencha:   cp .env.example .env
# O .env está no .gitignore. NUNCA versione o .env nem a pasta .state/
# =====================================================================

# --- Confluent Cloud ---------------------------------------------------
# Região do cluster, do Flink e (de preferência) do Neon: a mesma para os três.
CC_CLOUD=aws
CC_REGION=us-east-1
CC_ENV_NAME=desafio-final
CC_CLUSTER_NAME=desafio-basic
CC_POOL_NAME=desafio-pool
CC_POOL_MAX_CFU=5
# Prefixo de tudo (tópicos, ACLs, statements). Só minúsculas e sem ponto.
CC_PREFIX=desafio

# --- Postgres (Neon) ---------------------------------------------------
# Conexão do DONO do banco: roda os scripts SQL e o gerador de transações.
# Use o endpoint DIRETO (sem "-pooler" no host): replicação lógica não passa pelo pooler.
DATABASE_URL=postgresql://neondb_owner:TROQUE_AQUI@ep-exemplo-123456.us-east-1.aws.neon.tech/neondb?sslmode=require

# Usuário só-leitura do conector de CDC (crie "cdc_user" no console do Neon).
CDC_DB_HOST=ep-exemplo-123456.us-east-1.aws.neon.tech
CDC_DB_PORT=5432
CDC_DB_NAME=neondb
CDC_DB_USER=cdc_user
CDC_DB_PASSWORD=TROQUE_AQUI
